FRONTEND_URL=http://localhost:5173

# MongoDB Atlas Free cluster URI or local MongoDB URI
MONGO_URI=mongodb://127.0.0.1:27017/emotemoder

# Firebase Project settings -> Service accounts -> Admin SDK private key.
# The private key belongs only in this backend environment file / backend secret store.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-firebase-project-id.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nreplace-with-private-key-content\n-----END PRIVATE KEY-----\n"
