# Optional deployed API origin. Leave blank locally; Vite proxies /api to port 5000.
VITE_BACKEND_URL=https://your-api.onrender.com

# Public Firebase web-app config from Firebase Project settings -> General -> Your apps.
# These values identify the Firebase web app and are not Admin SDK credentials.
VITE_FIREBASE_API_KEY=your-firebase-web-api-key
VITE_FIREBASE_AUTH_DOMAIN=your-firebase-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-firebase-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-firebase-project-id.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your-sender-id
VITE_FIREBASE_APP_ID=your-web-app-id
